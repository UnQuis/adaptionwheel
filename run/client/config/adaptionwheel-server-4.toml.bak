#--- Wheel of Adaptation: Core ---
[core]
	#How many analysis processes can run at the same time.
	# Default: 5
	# Range: 1 ~ 20
	maxConcurrentAnalysis = 5
	#HP restored each time an adaptation finishes.
	# Default: 50
	# Range: 0 ~ 500
	healOnComplete = 50
	#Wipe all stored adaptations when the wearer dies.
	clearOnDeath = false
	#Preserve progress on the item itself so it carries over when re-equipped.
	persistOnItem = true

#--- Analysis Speed ---
[timing]
	#Seconds of exposure needed to decode an environmental hazard.
	# Default: 3.0
	# Range: 0.1 ~ 300.0
	envAnalysisTime = 3.0
	#Seconds of exposure needed to decode a status effect.
	# Default: 3.0
	# Range: 0.1 ~ 300.0
	debuffAnalysisTime = 3.0
	#Base seconds to decode a new damage type after first contact.
	# Default: 8.0
	# Range: 0.1 ~ 300.0
	defenseAnalysisTime = 8.0
	#Seconds shaved off a running defense analysis each time the player is hit again.
	# Default: 1.0
	# Range: 0.0 ~ 60.0
	defenseHitAcceleration = 1.0
	#Base seconds to decode a mob's offensive pattern.
	# Default: 8.0
	# Range: 0.1 ~ 300.0
	offenseAnalysisTime = 8.0
	#Seconds shaved off offense analysis per hit landed on the target.
	# Default: 1.0
	# Range: 0.0 ~ 60.0
	offenseHitAcceleration = 1.0
	#Minimum seconds between two Adversity triggers.
	# Default: 30.0
	# Range: 1.0 ~ 600.0
	adversityCooldown = 30.0
	#Seconds of sustained boss combat after the first hit (deal or receive) before existence adaptation completes.
	#Intentionally much slower than a full Lv8 offense analysis (~3 min at defaults).
	# Default: 240.0
	# Range: 5.0 ~ 36000.0
	existenceRequiredSeconds = 240.0
	#How close an adapted-progress boss has to stay for its existence timer to keep running.
	#Large arenas (e.g. Draconic Evolution's Chaos Guardian) may need a bigger radius.
	# Default: 96.0
	# Range: 16.0 ~ 512.0
	existenceProximityBlocks = 96.0
	#Seconds of fall exposure before the fall adaptation finishes.
	# Default: 3.0
	# Range: 0.1 ~ 300.0
	fallAnalysisTime = 3.0

#--- Module Toggles ---
[modules]
	#Decode incoming damage patterns for reduction.
	defense = true
	#Decode mob weaknesses for bonus damage and armor penetration.
	offense = true
	#Decode hazards like lava, drowning, void, darkness, ice, etc.
	environment = true
	#Decode harmful status effects for immunity.
	debuff = true
	#Allow the Adversity mechanism (survive lethal blow → mass analysis).
	adversity = true
	#Allow existence adaptation against bosses (full immunity to boss + attacks).
	existence = true
	#Decode drop tables of mobs for extra loot rolls.
	loot = true
	#Draconic Evolution compat: dedicated adaptation to the Chaos Guardian and all its attacks.
	#Once Existence_ChaosGuardian is decoded: full immunity to the guardian, its parts,
	#fireballs, laser (including the charged twin beam that normally bypasses damage events),
	#summoned guardian withers and crystals. Also enables reflection and minion inheritance.
	chaosGuardian = true
	#Decode movement restrictions imposed by blocks:
	#soul sand, honey block, powder snow, sweet berry bushes and bubble columns.
	#Exposure starts the usual analysis task; completion removes the restriction.
	movement = true
	#Decode mining labor: breaking blocks trains a permanent mining speed bonus (Lv1-8).
	mining = true
	#Decode combat discomforts: the 1.9 attack cooldown penalty
	#(leveled reduction, MAX ignores it) and axe shield-disabling (one-time immunity).
	combat = true
	#Decode perception limitations: steady gaze removes the hurt-camera shake.
	perception = true

#--- Discomfort Scaling ---
[discomfortScaling]
	#Mining speed bonus % at each Mine_Labor level (1-8).
	#Early levels are deliberately strong enough to feel (a bare +5 % read as 'not working').
	miningSpeedPct = [15.0, 30.0, 50.0, 75.0, 105.0, 140.0, 185.0, 240.0]
	#Share of the attack-cooldown damage penalty removed per Combat_Cooldown level.
	#100 = fully ignore the cooldown; values are % of the missing charge restored.
	#Only visible while attacking BELOW full charge (full swings have no penalty to remove).
	cooldownRecoveryPct = [25.0, 42.0, 56.0, 70.0, 82.0, 91.0, 97.0, 100.0]

#--- Combo Mutations ---
[mutations]
	#Aquatic Mastery: unlocked by Env_Liquid + Env_Drowning.
	#Grants a large permanent swim speed boost and faster underwater mining.
	aquaticMastery = true
	#Impact Mastery: unlocked by Env_FallDamage + Env_Knockback.
	#Landing from great heights unleashes a damaging shockwave.
	impactMastery = true
	#Minimum fall distance (blocks) to trigger the Impact shockwave.
	# Default: 6.0
	# Range: 1.0 ~ 200.0
	impactMinFallDistance = 6.0
	#Shockwave damage per block fallen above the threshold.
	# Default: 2.0
	# Range: 0.0 ~ 100.0
	impactDamagePerBlock = 2.0
	#Shockwave radius in blocks.
	# Default: 3.5
	# Range: 1.0 ~ 32.0
	impactRadius = 3.5
	#Flat swim speed bonus added by Aquatic Mastery.
	#(Base water swim acceleration is ~0.02; NeoForge swim-speed attribute scales it.)
	# Default: 2.5
	# Range: 0.0 ~ 20.0
	aquaticSwimSpeedBonus = 2.5

	#--- Fist Mastery (Mutation_Fist) ---
	[mutations.fistMastery]
		#Fist Mastery: max Mine_Labor and break a stone block bare-handed to
		#unlock a tool-less fist. The fist then advances through five materials
		#(Wood > Stone > Iron > Diamond > Netherite), 8 levels each.
		enabled = true
		#Let the fist actually collect the blocks it breaks.
		#Off = the fist only mines faster but tool-gated blocks still drop nothing.
		harvestWithoutTool = true
		#Blocks of the current tier's own material needed for its first level.
		# Default: 10
		# Range: 1 ~ 100000
		firstLevelBlocks = 10
		#Cost growth per level inside a tier (cost *= this each level).
		# Default: 1.35
		# Range: 1.0 ~ 10.0
		levelCostGrowth = 1.35
		#Per-tier cost multiplier, Wood > Stone > Iron >
		#Diamond > Netherite. Must have exactly one entry per material; a
		#wrong-length list is ignored and repaired.
		tierCostMultiplier = [1.0, 1.5, 2.5, 4.0, 5.0]
		#Multiplier on the vanilla tool speed the fist copies.
		#1.0 = exact parity with the matching tool; raise it to make the fist
		#outrun its tool equivalent.
		# Default: 1.0
		# Range: 0.1 ~ 20.0
		fistSpeedScale = 1.0
		#Netherite level 8 grants Instabreak: every breakable block is
		#removed in a single tick. Toggled in game with the Instabreak keybind.
		instabreakEnabled = true
		#Mining speed used while Instabreak is active. Must exceed the
		#hardest block's destroy speed by a wide margin (obsidian is 50).
		# Default: 20000.0
		# Range: 100.0 ~ 1000000.0
		instabreakSpeed = 20000.0
		#Whether Instabreak starts switched on the moment it is unlocked.
		instabreakDefaultOn = false
		#The fist's luck: every tier that much more of whatever an ore
		#drops, and the same multiple of its experience. Scales 1/2/3/5/10x by
		#tier and applies only to the blocks in the adaptionwheel:fist_luck
		#block tag.
		luckEnabled = true

	#--- Skill Issue (Combat_SkillIssue) ---
	[mutations.skillIssue]
		#Skill Issue: projectiles from adapted bows/crossbows/tridents gently home in,
		#but ONLY onto entities whose bodies lie close to the arrow's flight path.
		#Shooting into empty space stays completely untouched - no target near the path, no correction.
		enabled = true
		#How far (blocks) an entity may sit from the flight path to be catchable.
		#'Close' counts after subtracting the entity's own half-width.
		# Default: 2.0
		# Range: 0.5 ~ 8.0
		radius = 2.0
		#Steering blend per tick: 0 = vanilla flight, 1 = instant lock-on.
		#Values around 0.4-0.5 convert a near-miss within a couple of blocks of travel.
		# Default: 0.45
		# Range: 0.05 ~ 1.0
		strength = 0.45
		#Maximum distance (blocks) ahead along the path where targets are considered.
		# Default: 16.0
		# Range: 2.0 ~ 64.0
		maxDistance = 16.0

	#--- Dimension Destroy (transcendence ultimate) ---
	[mutations.dimensionDestroy]
		#Port of the original mod's Dimension Destroy: past the adaptation
		#threshold, Sword of Extermination swings tear three spatial rifts that sever
		#up to five lives each outright. Players are never targeted.
		enabled = true
		#Adaptations on the wheel required to unlock Dimension Destroy.
		#The original gates it behind Transcendence; this mod uses the same idea.
		# Default: 450
		# Range: 1 ~ 1000
		adaptationsRequired = 450

#--- Contact Defense ---
[contactDefense]
	#At which contact level the player gains TOTAL immunity to that mob (no damage, no red flash).
	#Set to 0 to disable full immunity entirely; the protection table below still applies.
	#At level 8 the protection table reaches 60 % — set this to 9 or higher if you want
	#the table to be the ONLY defense mechanism without any hard immunity.
	# Default: 0
	# Range: 0 ~ 64
	immunityLevel = 0
	#Damage reduction % applied per contact level (1-8).
	#These are checked BEFORE the immunity level — so even without immunity,
	#high-level contact adaptations still provide meaningful protection.
	protectionPerLevel = [5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 45.0, 60.0]

#--- Shortcuts ---
[shortcuts]
	#Decode starvation immediately on first tick and refill hunger to full.
	instantStarve = true
	#Use a short dedicated timer for fall analysis instead of the generic env timer.
	rapidFall = true
	#Adaptation sound volume (0 = silent, 100 = max).
	# Default: 100
	# Range: 0 ~ 100
	voiceVolume = 100
	#Sparkle particles around the wheel above the head (denser while analyzing).
	wheelParticles = true

#--- Defense Scaling (Lv1-8) ---
[defenseScaling]
	#Flat damage reduction % at each defense level against that damage type.
	reductionPct = [5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 45.0, 60.0]
	#At Lv5+ a fraction of incoming damage is converted to healing.
	#Values are % of damage absorbed.
	lifestealPct = [0.0, 0.0, 0.0, 0.0, 10.0, 15.0, 30.0, 50.0]

#--- Regeneration ---
[regeneration]
	#Below this % of max HP the wheel begins injury analysis.
	# Default: 50.0
	# Range: 1.0 ~ 100.0
	hpThresholdPct = 50.0
	#Thermal Mastery mutation: heat-scaled regeneration (requires maxed Type_FIRE + Env_Lava).
	thermalRegenEnabled = true
	#HP per second while standing in lava (scaled down by the heat factor in weaker heat).
	# Default: 2.0
	# Range: 0.0 ~ 100.0
	thermalRegenHpPerSecond = 2.0
	#HP regenerated per second at each injury level.
	hpPerSecond = [1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 10.0, 15.0]

#--- Offense Scaling (Lv1-8) ---
[offenseScaling]
	#Flat bonus damage added per offense level.
	flatDamageBonus = [2.0, 3.0, 5.0, 7.0, 9.0, 10.0, 13.0, 15.0]
	#Crit chance % added per offense level.
	critChancePct = [5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 35.0, 50.0]
	#Armor penetration % per offense level.
	armorPenPct = [12.0, 25.0, 37.0, 50.0, 62.0, 75.0, 87.0, 100.0]
	#Bonus damage as % of target max HP when Dimension Slash triggers (Lv8 offense).
	# Default: 7.0
	# Range: 0.0 ~ 100.0
	dimensionSlashHpPct = 7.0
	#Probability % for Dimension Slash to activate per hit at Lv8 offense.
	# Default: 6.0
	# Range: 0.0 ~ 100.0
	dimensionSlashChancePct = 6.0

#--- Loot Scaling (Lv1-8) ---
[lootScaling]
	#Extra loot roll multiplier % at each drop level.
	#100 = one extra roll, 1000 = ten extra rolls, etc.
	extraRollPct = [100.0, 300.0, 500.0, 1000.0, 1500.0, 3000.0, 5000.0, 10000.0]
	#Total kills of a mob required to reach each drop level.
	killThresholds = [1.0, 5.0, 10.0, 30.0, 100.0, 300.0, 500.0, 1000.0]

#--- Cumulative Bonuses ---
[cumulativeBonuses]
	#% damage bonus multiplied by the total number of completed adaptations.
	# Default: 0.5
	# Range: 0.0 ~ 100.0
	damagePctPerAdaptation = 0.5
	#% crit bonus multiplied by the total number of completed adaptations.
	# Default: 0.5
	# Range: 0.0 ~ 100.0
	critPctPerAdaptation = 0.5
	#% max HP bonus multiplied by the total number of completed adaptations.
	# Default: 0.5
	# Range: 0.0 ~ 100.0
	hpPctPerAdaptation = 0.5
	#Flat armor points added per completed adaptation.
	# Default: 0.5
	# Range: 0.0 ~ 100.0
	armorPerAdaptation = 0.5

#--- Existence Reflection ---
[existenceReflection]
	#Reflected damage multiplier applied to an adapted boss that touches the wearer
	#(the original mod reflects contact hits at 3x).
	# Default: 3.0
	# Range: 0.0 ~ 100.0
	reflectMultiplier = 3.0

#--- Wheel Awakening ---
[wheelTiers]
	#The wheel has tiers of its own, reached by holding more
	#adaptations. Each tier REVEALS another family of adaptations -- Contact,
	#Offense, Plunder, Existence -- so what the wheel can adapt to grows.
	#A tier never takes anything away and never costs anything: the wheel is
	#meant to be omnipotent, so a later tier is only ever a larger one.
	enabled = true

#--- Shedding ---
[shedding]
	#A player may deliberately shed (give up) one of their adaptations
	#for a Wild Release burst. Nothing is lost for good: the concept becomes
	#re-analysable immediately, and at a fraction of the original time, because
	#the wheel remembers what it already worked out. Shedding is a swap, not a price.
	#Deliberately there is no downside anywhere in this feature: the point of the
	#wheel is that it can do anything, so acting on it must never be a trap.
	enabled = true
	#Wild Release duration at level 1, in ticks
	# Default: 200
	# Range: 20 ~ 12000
	releaseBaseTicks = 200
	#Extra Wild Release ticks per level of a shed
	#leveled adaptation
	# Default: 40
	# Range: 0 ~ 1200
	releaseTicksPerLevel = 40
	#How much of the original analysis time a re-shed
	#concept costs the second time, as a fraction. 0.35 means it re-adapts in
	#about a third of the time; 1.0 would make shedding pointless.
	# Default: 0.35
	# Range: 0.05 ~ 1.0
	reattachTimerFactor = 0.35
	#Refuse a shed that would drop the player's wheel tier.
	#Without this, shedding the last adaptation of a family re-locks that whole
	#family -- taking something away, which this mod does not do. The refusal is
	#reported as a message, not silently.
	protectTier = true

#--- Ritual Blocks ---
[ritual]
	#The Adaptation Brazier heals a wheel-wearer standing
	#within 5 blocks. A flat amount per second per brazier, so a field of them
	#is worth more than one but never more than is missing.
	brazierHealEnabled = true
	# Default: 0.5
	# Range: 0.0 ~ 20.0
	brazierHealPerSecond = 0.5
	#The Wheel Totem advances the analyses already running for a
	#wheel-wearer within 6 blocks. It grants nothing, so it is worth nothing to
	#a player with nothing to analyse.
	totemEnabled = true
	# Default: 20
	# Range: 0 ~ 400
	totemAccelerationTicks = 20
	#The Resonance Altar adds one rung to a wheel-wearer's Resonance
	#within 8 blocks. It raises the rung rather than widening the search, so
	#stacking altars cannot stand in for other players.
	altarEnabled = true
	#The Domain Stone hands out an adaptation when
	#right-clicked while wearing the wheel, preferring a family the wheel has
	#not revealed yet. It is the only place in the mod where an adaptation is
	#given rather than endured.
	domainStoneEnabled = true
	#Per-player cooldown. Pacing, not a price: the
	#stone's pool excludes what you already hold, so it always has less to
	#give the more you take from it.
	# Default: 30
	# Range: 1 ~ 3600
	domainStoneCooldownSeconds = 30

#--- Adaptation Transfer ---
[transfer]
	#Right-clicking another player with the wheel in hand hands
	#them your most developed adaptation that they do not have. Repeated
	#clicks walk down your own list. Nothing is invented: what they gain is
	#exactly what you gave up, at the same level.
	enabled = true

#--- Resonance ---
[resonance]
	#Adapted players within range strengthen each other. The buff
	#rung counts OTHER wheel-wearers nearby and saturates at its maximum, so a
	#large group is not proportionally stronger than a small one.
	enabled = true
	#Radius in blocks
	# Default: 12.0
	# Range: 2.0 ~ 64.0
	blocks = 12.0
	#Draw a small burst at a wearer's feet when their rung rises
	particles = true
